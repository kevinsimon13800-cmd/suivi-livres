rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Remplace le texte entre guillemets ci-dessous par l'UID de ton compte
    // (Firebase > Authentication > Utilisateurs > colonne "UID utilisateur").
    function isOwner() {
      return request.auth != null && request.auth.uid == 'OWNER_UID';
    }

    // Livres : les visiteurs ne lisent que les livres publics ; seul le propriétaire écrit.
    match /books/{bookId} {
      allow read: if resource.data.public == true || isOwner();
      allow write: if isOwner();
    }

    // Profil public : lecture pour tous, écriture réservée au propriétaire.
    match /profile/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Notes-Idées : strictement privées (lecture et écriture réservées au propriétaire).
    match /notes/{noteId} {
      allow read, write: if isOwner();
    }

    // Mes lectures : visibles par tous (section publique), modifiables par le propriétaire seulement.
    match /readings/{readingId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Statistiques de visites : chaque visiteur peut seulement ajouter +1 ; lecture réservée au propriétaire.
    match /stats/{key} {
      allow read: if isOwner();
      allow create: if key.matches('^(all|d-[0-9]{4}-[0-9]{2}-[0-9]{2}|w-[0-9]{4}-W[0-9]{2}|m-[0-9]{4}-[0-9]{2}|q-[0-9]{4}-Q[1-4]|s-[0-9]{4}-S[12]|y-[0-9]{4})$')
        && request.resource.data.keys().hasOnly(['visits', 'visitors'])
        && request.resource.data.get('visits', 0) in [0, 1]
        && request.resource.data.get('visitors', 0) in [0, 1];
      allow update: if request.resource.data.keys().hasOnly(['visits', 'visitors'])
        && request.resource.data.get('visits', 0) - resource.data.get('visits', 0) in [0, 1]
        && request.resource.data.get('visitors', 0) - resource.data.get('visitors', 0) in [0, 1];
    }

    // Personnages et liens (atelier) : strictement privés, comme les notes.
    match /characters/{charId} {
      allow read, write: if isOwner();
    }
    match /relations/{relId} {
      allow read, write: if isOwner();
    }

    // Prochain chapitre (site/chapter) et sondage (site/poll) : lecture pour tous, écriture propriétaire.
    match /site/{docId} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Votes du sondage : un document par choix, avec un seul champ `votes` (entier).
    // Tout le monde peut seulement créer un compteur à 1, ou ajouter +1 / retirer 1 (sans passer sous 0).
    match /pollCounts/{countId} {
      allow read: if true;
      allow write: if isOwner();
      allow create: if request.resource.data.keys().hasOnly(['votes'])
        && request.resource.data.votes == 1;
      allow update: if request.resource.data.keys().hasOnly(['votes'])
        && request.resource.data.votes is int
        && request.resource.data.votes >= 0
        && (request.resource.data.votes - resource.data.votes == 1
            || request.resource.data.votes - resource.data.votes == -1);
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
